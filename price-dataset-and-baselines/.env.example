# --- HuggingFace ---------------------------------------------------------
# Needed to PUSH datasets / weights (write token) and to READ the private datasets
# such as rampangeni/items_full (or run `hf auth login` instead).
HF_TOKEN=hf_...
# Hugging Face namespace for the dataset repos (items_full, items_lite, items_raw_*).
# Change it to publish to a different account or org.
HF_USERNAME=rampangeni

# --- Summarisation -------------------------------------------------
GROQ_API_KEY=gsk_...
# litellm model used by the non-batch preprocessor (any litellm provider)
PREPROCESSOR_MODEL=groq/openai/gpt-oss-20b

# --- Frontier comparison  - only the providers you want to test ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...
