# Only set the providers you want to use. Models whose key is missing are still
# listed in the UI but fail with a clear message when selected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key; it must be running at this URL for local models.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional overrides of the default frontier model names
# OPENAI_MODEL=gpt-5
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# GROK_MODEL=grok-4
# GEMINI_MODEL=gemini-2.5-pro

# Seconds before a run (python / compiled binary) or compile is killed
RUN_TIMEOUT=60
COMPILE_TIMEOUT=120
