# At least one provider is needed. Only OPENAI_API_KEY is required for the default "GPT" choice.
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama needs no key; just `ollama serve` + `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional model overrides (defaults are set in the code)
# GPT_MODEL=gpt-4.1-mini
# GPT_LINK_MODEL=gpt-5-nano
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# CLAUDE_LINK_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LINK_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=llama3.2
