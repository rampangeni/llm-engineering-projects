# --- API path (no GPU needed) ---
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Local GPU path ---
# Needed to download the gated Llama model: accept the licence on
# https://huggingface.co/meta-llama/Meta-Llama-3.1-8B-Instruct then create a token.
HF_TOKEN=
# WHISPER_MODEL=openai/whisper-medium
# LLAMA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# MAX_NEW_TOKENS=2000

# auto = local if a CUDA GPU + local extras are present, else api
# BACKEND=auto
