# ================= LLM providers =================
OPENAI_API_KEY=sk-...                  # Scanner, Frontier, Autonomous planner
# Messaging agent uses litellm; default model is Claude, so also set:
ANTHROPIC_API_KEY=sk-ant-...           # (or set MESSAGING_MODEL=gpt-5-mini and skip this)
# Preprocessor (litellm). Default is local Ollama; or e.g. groq/openai/gpt-oss-20b + GROQ_API_KEY
PRICER_PREPROCESSOR_MODEL=ollama/llama3.2
# GROQ_API_KEY=

# ================= Modal specialist (../price-model-modal-service) =================
# modal | mock   (mock = deterministic offline stub for development)
SPECIALIST_BACKEND=modal
MODAL_APP_NAME=pricer-service
MODAL_CLASS_NAME=Pricer
# Modal auth is stored by `modal token set ...`; no key needed here.

# ================= Hugging Face =================
HF_TOKEN=hf_...                        # needed for build-vectorstore if the dataset is private
# Items dataset produced by ../price-dataset-and-baselines
HF_ITEMS_DATASET=rampangeni/items_full  # pre-built dataset (private: needs HF_TOKEN); or rampangeni/items_lite for a quick start

# ================= Pushover =================
PUSHOVER_USER=
PUSHOVER_TOKEN=
# Unset => notifications are logged but not sent (dry run)

# ================= Agent behaviour =================
SCANNER_MODEL=gpt-5-mini
FRONTIER_MODEL=gpt-5.1
FRONTIER_REASONING_EFFORT=none
PLANNER_MODEL=gpt-5.1
MESSAGING_MODEL=claude-sonnet-4-5
# workflow (PlanningAgent) | autonomous (tool-calling LLM)
PLANNER=workflow
DEAL_THRESHOLD=50
# frontier:specialist:nn weights (renormalised over available components)
ENSEMBLE_WEIGHTS=frontier:0.8,specialist:0.1,nn:0.1
# weighted | min
ENSEMBLE_STRATEGY=weighted
ENABLE_SPECIALIST=1
ENABLE_FRONTIER=1
ENABLE_NN=1
ENABLE_PREPROCESSOR=1
# The scanner reads these RSS feeds (comma separated); defaults to 3 dealnews feeds
# DEAL_FEEDS=https://www.dealnews.com/c142/Electronics/?rss=1,https://www.dealnews.com/c39/Computers/?rss=1

# ================= Paths =================
CHROMA_PATH=products_vectorstore
MEMORY_PATH=memory.json
# Weights from ../price-dataset-and-baselines (deep_neural_network.pth)
NN_WEIGHTS_PATH=deep_neural_network.pth

# ================= UI =================
UI_REFRESH_SECONDS=300
UI_PLOT_POINTS=800
