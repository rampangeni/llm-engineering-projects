# Backend: "openai" (default; needed for image generation and text-to-speech) or "ollama" (text + tools only)
ASSISTANT_BACKEND=openai
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx

# Ollama (used when ASSISTANT_BACKEND=ollama). Needs a tool-capable model, e.g. llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Let the chat model change prices through the set_ticket_price tool (demo only! off by default)
ENABLE_ADMIN_TOOLS=0

# Optional basic auth for the Gradio UI (no auth when unset)
GRADIO_USER=
GRADIO_PASSWORD=
