# ---- Modal (auth is normally stored by `modal token set`, not here) ----
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# ---- Names used both when deploying and when calling the deployed app ----
MODAL_APP_NAME=pricer-service
MODAL_CLASS_NAME=Pricer
MODAL_FUNCTION_NAME=price
# Name of the Modal Secret that holds HF_TOKEN (create it in the Modal dashboard)
HF_SECRET_NAME=huggingface-secret

# ---- Model artifacts (produced by ../price-predictor-qlora-training) ----
BASE_MODEL=meta-llama/Llama-3.2-3B
# Adapter repo = ADAPTER_REPO if set, else {HF_USER}/{PROJECT_NAME}-{RUN_NAME}
HF_USER=rampangeni  # private pre-built adapter, lets you skip training (needs the HF token as a Modal secret)
PROJECT_NAME=price
RUN_NAME=2025-11-28_18.47.07
ADAPTER_REVISION=3e6de2528c7987fd54ac0c47094066f293655dc4
# ADAPTER_REPO=your-hf-user/price-2025-xx-xx_xx.xx.xx
# Fallback: serve the plain base model (no adapter) - runs, but price quality is poor
# BASE_ONLY=1

# ---- Compute / scaling ----
GPU=T4
TIMEOUT_SECONDS=1800
# 0 = scale to zero when idle; 1 = always one warm container (costs credits!)
MIN_CONTAINERS=0
SCALEDOWN_WINDOW_SECONDS=120
HF_CACHE_VOLUME=hf-hub-cache

# ---- Client side ----
# modal-class | modal-function | mock
PRICER_BACKEND=modal-class
CLIENT_RETRIES=3
# Optional text rewriting before pricing (litellm model string)
PRICER_PREPROCESSOR_MODEL=ollama/llama3.2
# OPENAI_API_KEY / GROQ_API_KEY are needed only if the preprocessor model is a hosted one
