# Required for the default setup (LLM calls and, for "pro", embeddings)
OPENAI_API_KEY=sk-...

# Only needed if you point a model at Groq (e.g. PRO_LLM_MODEL=groq/openai/gpt-oss-120b)
# GROQ_API_KEY=

# --- Optional overrides (defaults shown) ---
# RAG_PIPELINE=basic                       # basic | pro
# RAG_DATA_DIR=./data                      # holds knowledge-base/, tests.jsonl, vector_db/
# BASIC_LLM_MODEL=openai/gpt-4.1-nano
# PRO_LLM_MODEL=openai/gpt-4.1-nano
# BASIC_EMBEDDING=hf:all-MiniLM-L6-v2      # or openai:text-embedding-3-large
# PRO_EMBEDDING=openai:text-embedding-3-large
# JUDGE_LLM_MODEL=openai/gpt-4.1-nano
