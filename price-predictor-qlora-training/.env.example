# HuggingFace: read the gated Llama base model + push adapters (needs a WRITE token)
HF_TOKEN=hf_...
# Your HF namespace: adapters are pushed to <HF_USERNAME>/price-<run name>;
# datasets are read from <HF_USERNAME>/items_prompts_{full,lite} (default: the private pre-built ones; needs HF_TOKEN or `hf auth login`)
HF_USERNAME=your-hf-username
# Where to read the prompt datasets from (default: rampangeni)
DATASET_USERNAME=rampangeni

# Weights & Biases (optional but recommended)
WANDB_API_KEY=
WANDB_PROJECT=price

# Base model (Llama is gated: accept the licence on its HF page first)
BASE_MODEL=meta-llama/Llama-3.2-3B
