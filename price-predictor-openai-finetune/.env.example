# OpenAI key with fine-tuning access (billing enabled)
OPENAI_API_KEY=sk-...

# HuggingFace: the dataset produced by price-dataset-and-baselines
HF_TOKEN=hf_...
# Namespace of the dataset. Default = the private pre-built datasets (needs HF_TOKEN or `hf auth login`)
HF_USERNAME=rampangeni

# Optional Weights & Biases tracking of the fine-tuning job.
# You must ALSO link your W&B key in the OpenAI dashboard (Settings > Integrations).
WANDB_PROJECT=gpt-pricer
